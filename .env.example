# Copy to .env (same folder as manage.py) and fill in real values.
# Every variable below is read by LuckyProject/settings.py and must be present,
# even if you don't use the related feature locally.

# --- Django ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (PostgreSQL) ---
# HOST is fixed to "localhost" in settings.py.
# Note: on Linux/macOS the shell already defines USER, and it takes precedence
# over the value below (django-environ does not override existing variables).
ENGINE=django.db.backends.postgresql
NAME=jouets
USER=postgres
PASSWORD=your-db-password
PORT=5432

# --- Email ---
# Console backend prints emails to the terminal; use smtp.EmailBackend for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-email-app-password

# --- Celery broker (optional) ---
# Not referenced in settings.py; Celery reads it from the environment directly.
# If unset, Celery defaults to RabbitMQ at amqp://guest@localhost:5672//.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Google sign-in (social-auth-app-django) ---
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-client-id.apps.googleusercontent.com
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-client-secret

# --- Braintree (sandbox; card payments are currently disabled in code) ---
BRAINTREE_MERCHANT_ID=your-merchant-id
BRAINTREE_PUBLIC_KEY=your-public-key
BRAINTREE_PRIVATE_KEY=your-private-key
